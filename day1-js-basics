const prompt = require("prompt-sync")();

function playGuessingGame() {
    const secretNumber = 7;
    let userGuess = null;

    console.log("--- Task 4: Guessing Game Started ---");

    while (userGuess !== secretNumber) {
        const input = prompt("Guess a number between 1 and 10: ");
        userGuess = Number(input);

        if (userGuess === secretNumber) {
            console.log("🎉 Correct! You guessed the secret number!");
        } else {
            console.log(`Wrong guess (${userGuess}). Try again!`);
        }
    }
}

playGuessingGame();